{
  "layer": "top",
  "height": 28,
  "spacing": 0,
  "modules-left": [
    "user",
    "hyprland/workspaces",
    "custom/spotify"
  ],
  "modules-center": [
    "clock",
    "hyprland/language"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "group/tray-expander",
    "custom/power",
  ],
  "hyprland/window": {
    "separate-outputs": false
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "ignore-workspaces": [
            "secret"
        ]
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-ar": "AR",
    "swap-icon-label": false,
    "on-click": "hyprctl switchxkblayout current next"
  },
  "user": {
    "format": "({work_H}:{work_M}:{work_S} ↑)",
    "interval": 1,
    "height": 23,
    "width": 23
  },
    "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },
  "tray": {
    "icon-size": 15,
    "spacing": 7,
    "tooltip": false
  },
  "clock": {
    "interval": 1,
    "tooltip-format": "<big>{calendar}</big>",
    "format": "{:%I:%M %p | %a %d %b} | "
  },
  "network": {
    "format-ethernet": "⇣{bandwidthDownBytes}",
    "interval": 2,
    "format-disconnected": "󰱟",
    "tooltip-format-ethernet": "{ipaddr}"
  },
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "{icon}  {volume}",
    "format-muted": "shhh..",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{volume}% volume",
    "on-click": "pwvucontrol"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout"
  },
  "custom/spotify": {
    "interval": 1,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/music2.sh",
    "on-click": "playerctl --player=spotify play-pause && sleep 0.1 && pkill -SIGRTMIN+8 waybar",
    "signal": 8,
    "escape": true
  }
}
// vim: ft=jsonc
